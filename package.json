{
  "name": "saunf",
  "private": true,
  "description": "Saunf Meal Subscription Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "dev:api": "pnpm --filter @saunf/api run dev",
    "dev:web": "pnpm --filter @saunf/web run dev",
    "build": "pnpm --filter './apps/*' run build",
    "lint": "pnpm --filter './apps/*' --filter './packages/*' run lint",
    "test": "pnpm --filter './apps/*' --filter './packages/*' run test",
    "test:api": "pnpm --filter @saunf/api run test",
    "db:migrate": "pnpm --filter @saunf/api run db:migrate",
    "db:seed": "pnpm --filter @saunf/api run db:seed"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1"
  }
}
